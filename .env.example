# ============================================================================
# LoyaltyCr - Variables de entorno
# Copia este archivo a .env en la raiz (para Docker) y a apps/api/.env y
# apps/web/.env segun corresponda. NUNCA subas el .env real al repositorio.
# ============================================================================

# ---------------------------------------------------------------------------
# Base de datos
# ---------------------------------------------------------------------------
# Si usas el docker-compose.yml incluido, esta es la connection string correcta:
DATABASE_URL="postgresql://loyaltycr:loyaltycr_dev_password@localhost:5432/loyaltycr?schema=public"

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL="http://localhost:4000"
WEB_BASE_URL="http://localhost:5173"

# ---------------------------------------------------------------------------
# JWT / Sesiones
# ---------------------------------------------------------------------------
# Genera valores fuertes con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="reemplaza_con_un_secreto_fuerte_de_al_menos_64_caracteres"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS=30
COOKIE_SECRET="reemplaza_con_otro_secreto_fuerte_distinto_al_de_jwt"

# ---------------------------------------------------------------------------
# Email (para verificacion de cuenta y reset de password)
# En desarrollo, si no configuras estas variables, los correos se imprimen
# en la consola del API en vez de enviarse (ver packages/notifications).
# ---------------------------------------------------------------------------
EMAIL_PROVIDER="console"          # "console" | "resend" | "smtp"
EMAIL_FROM="LoyaltyCr <no-reply@loyaltycr.com>"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# ---------------------------------------------------------------------------
# APPLE WALLET (PassKit)
# ---------------------------------------------------------------------------
# Como obtener estas credenciales: ver docs/APPLE_WALLET.md paso a paso.
# Requiere una cuenta de Apple Developer Program (pago, ~$99/ano).
#
# APPLE_TEAM_ID
#   Tu Team ID de Apple Developer. Se encuentra en
#   https://developer.apple.com/account -> Membership.
#
# APPLE_PASS_TYPE_ID
#   El Pass Type Identifier que registras en
#   https://developer.apple.com/account/resources/identifiers/list/passTypeId
#   (formato: pass.com.tuempresa.loyaltycr)
#
# APPLE_CERTIFICATE_BASE64
#   El certificado .p12 (Pass Type ID Certificate, exportado desde Keychain
#   Access en macOS luego de generarlo en el portal de Apple Developer),
#   codificado en base64: base64 -i Certificates.p12 | tr -d '\n'
#
# APPLE_CERTIFICATE_PASSWORD
#   El password que le pusiste al exportar el .p12 desde Keychain Access.
#
# APPLE_WWDR_CERTIFICATE_BASE64
#   El certificado intermedio "Apple Worldwide Developer Relations" (WWDR),
#   descargable desde https://www.apple.com/certificateauthority/ ,
#   codificado en base64 igual que el anterior.
#
# APPLE_APNS_KEY_BASE64 / APPLE_APNS_KEY_ID
#   Clave APNs (.p8) generada en https://developer.apple.com/account/resources/authkeys/list
#   para poder enviar push notifications de actualizacion de pass via
#   Apple Push Notification service. Necesaria para el Wallet Web Service
#   (register device / actualizaciones push, ver seccion 3 de docs/APPLE_WALLET.md).
APPLE_TEAM_ID=""
APPLE_PASS_TYPE_ID=""
APPLE_CERTIFICATE_BASE64=""
APPLE_CERTIFICATE_PASSWORD=""
APPLE_WWDR_CERTIFICATE_BASE64=""
APPLE_APNS_KEY_BASE64=""
APPLE_APNS_KEY_ID=""

# ---------------------------------------------------------------------------
# GOOGLE WALLET
# ---------------------------------------------------------------------------
# Como obtener estas credenciales: ver docs/GOOGLE_WALLET.md paso a paso.
# Requiere inscribirte en Google Wallet Console (gratuito, con aprobacion manual).
#
# GOOGLE_WALLET_ISSUER_ID
#   Tu Issuer ID, visible en https://pay.google.com/business/console
#   despues de que tu cuenta de "Google Wallet API" sea aprobada.
#
# GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL / GOOGLE_WALLET_SERVICE_ACCOUNT_KEY_BASE64
#   Credenciales de una Service Account de Google Cloud con el rol
#   "Wallet Object Issuer" habilitado, creada en
#   https://console.cloud.google.com/iam-admin/serviceaccounts
#   Descarga el JSON de la cuenta de servicio y codifica el contenido completo
#   en base64: base64 -i service-account.json | tr -d '\n'
GOOGLE_WALLET_ISSUER_ID=""
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY_BASE64=""

# ---------------------------------------------------------------------------
# Web Push (VAPID) - para notificaciones push del portal cliente (no Wallet)
# Genera con: npx web-push generate-vapid-keys
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:soporte@loyaltycr.com"

# ---------------------------------------------------------------------------
# Preparado para integraciones futuras (no requeridas en Fase 1-5)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# ---------------------------------------------------------------------------
# Frontend (Vite expone solo variables con prefijo VITE_)
# ---------------------------------------------------------------------------
VITE_API_BASE_URL="http://localhost:4000"
